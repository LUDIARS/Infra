# 共有インフラ設定
# 各サービスの .env からこれらの値を参照する

# PostgreSQL (共有)
PG_HOST=localhost
PG_PORT=5432
PG_ADMIN_USER=ludiars
PG_ADMIN_PASS=ludiars

# 各サービスの接続文字列
# Cernere:  postgresql://cernere_user:cernere@localhost:5432/cernere
# Schedula: postgresql://schedula_user:schedula@localhost:5432/schedula
# Curare:   postgresql://curare_user:curare@localhost:5432/curare

# Redis (共有、DB番号で分離)
# Cernere:  redis://localhost:6379/0
# Schedula: redis://localhost:6379/1
# Curare:   redis://localhost:6379/2

# MinIO (Curare のみ使用)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=curare
# MINIO_SECRET_KEY=curare-secret
